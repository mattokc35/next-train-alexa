{
  "name": "next-train-alexa",
  "version": "1.0.0",
  "description": "Custom Alexa skill that reports next-train arrivals and delay/detour status for PATH train riders.",
  "private": true,
  "license": "MIT",
  "main": "dist/lambda/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.ts\" \"infra/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"infra/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"infra/**/*.ts\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"infra/**/*.ts\" \"*.md\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "adm-zip": "^0.6.1",
    "ask-cli": "^2.30.7",
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-dynamodb-persistence-adapter": "^2.14.0",
    "ask-sdk-model": "^1.39.0",
    "g": "^2.0.1",
    "puppeteer-core": "^25.12.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/aws-lambda": "^8.10.147",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.71",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
